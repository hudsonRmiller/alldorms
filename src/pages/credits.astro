---
import Base from '../layouts/Base.astro';
import { getSchool } from '../lib/site.js';
import credits from '../data/photo-credits.json';

// photo-credits.json is written by scripts/photos.mjs on every assign
const entries = Object.entries(credits).map(([file, c]) => ({
  ...c,
  file,
  where: getSchool(c.for)?.name || 'Homepage',
}));
---
<Base
  title="Photo credits · AllDorms"
  description="Attribution for the campus photography used across AllDorms."
>
  <section class="credits">
    <div class="wrap">
      <span class="kick">Photo credits</span>
      <h1>The photographers behind the campuses.</h1>
      <p class="credits-lede">
        Much of the campus photography on AllDorms comes from the photographers of
        Wikimedia Commons, used under the licenses noted below — with our thanks.
        Photos may be cropped and resized.
      </p>
      <ul class="credit-list">
        {entries.map(c => (
          <li>
            <span class="credit-where">{c.where}</span>
            <span class="credit-what">
              <a href={c.source}>{c.title}</a>
              <span class="credit-meta">{c.artist} · {c.license}</span>
            </span>
          </li>
        ))}
      </ul>
    </div>
  </section>
</Base>

<style>
  .credits { padding: clamp(7rem, 12vh, 9rem) 0 5rem; }
  .credits h1 { font-size: clamp(2rem, 4vw, 3rem); line-height: 1.08; margin: .4rem 0 .7rem; max-width: 22ch; }
  .credits-lede { font-size: 1.08rem; line-height: 1.6; color: var(--ink-soft); max-width: 58ch; margin-bottom: 2.6rem; }
  .credit-list { list-style: none; margin: 0; padding: 0; max-width: 760px; }
  .credit-list li {
    display: grid; grid-template-columns: 11rem 1fr; gap: 1rem;
    padding: .85rem 0; border-top: 1px solid var(--line, rgba(0,0,0,.1));
  }
  .credit-list li:last-child { border-bottom: 1px solid var(--line, rgba(0,0,0,.1)); }
  .credit-where { font-family: var(--sans); font-size: .92rem; font-weight: 600; }
  .credit-what { display: flex; flex-direction: column; gap: .15rem; min-width: 0; }
  .credit-what a { overflow-wrap: anywhere; }
  .credit-meta { font-size: .88rem; color: var(--ink-soft); }
  @media (max-width: 560px) {
    .credit-list li { grid-template-columns: 1fr; gap: .2rem; }
  }
</style>
